{
  "tasks": {
    "stop": "pm2 stop leonardo",
    "start": "pm2 start --interpreter='deno' --interpreter-args='serve -A --port 5056' --name leonardo index.ts && pm2 logs leonardo",
    "logs": "pm2 logs leonardo",
    "reload": "pm2 reload leonardo && pm2 logs leonardo",
    "delete": "pm2 delete leonardo",
    "check": "deno check --allow-import index.ts",
    "run": "deno serve -A --port 5056 index.ts",
    "watch": "deno serve -A --watch --port 5056 index.ts",
    "run:molt": "deno run --allow-import --allow-env --allow-read --allow-write=. --allow-run=git,deno --allow-net=deno.land,esm.sh,cdn.jsdelivr.net https://deno.land/x/molt/cli.ts",
    "update_deps": "deno task -q run:molt check ./**/*.ts"
  },
  "imports": {
    "@std/crypto": "jsr:@std/crypto@^1.0.4",
    "@std/encoding": "jsr:@std/encoding@^1.0.7",
    "@std/media-types": "jsr:@std/media-types@^1.1.0",
    "@std/path": "jsr:@std/path@^1.0.8",
    "node-poppler": "npm:node-poppler@^7.2.4"
  }
}
